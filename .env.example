# ====================================================
# News Agent — Environment Template
# ====================================================
# SECURITY NOTE: Real secrets live ONLY in `.env` (gitignored).
# This file contains placeholders. Never commit real credentials.

# ── Telegram API ─────────────────────────────────────
# Get from https://my.telegram.org/apps (put real values in .env only)
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID_HERE
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH_HERE

# Telegram Bot Token (for publishing to channels)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=@YOUR_CHANNEL_HERE

# قنوات التيليجرام للمراقبة (مفصولة بفاصلة)
# يفضل استخدام أسماء مستخدمين/قنوات متخصصة في أخبار الشركات المدرجة
TELEGRAM_CHANNELS=AlBorsaNews,EGXNews,egx_news_ar,mubasher_egx,egyptstock,Arabian_investment_guide,EGX_news,StocksEgypt

# ── Ollama ────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:1.5b
# نموذج الرؤية لفهم الصور (اختياري — اتركه فارغ لو مش محتاج)
OLLAMA_VISION_MODEL=

# ── الموقع المحلي (GLMinvestment) ────────────────────
LOCAL_SITE_URL=http://localhost:3000

# ── GLMinvestment API Key ─────────────────────────────
# Same value as NEWS_AGENT_API_KEY in GLMinvestment/.env
# Must match for auth to work on POST /api/news
PRODUCTION_API_KEY=YOUR_NEWS_AGENT_API_KEY_HERE

# ── السيرفر الإنتاجي ────────
PRODUCTION_SERVER_URL=https://invist.m2y.net

# ── Social Media (not active) ──────────────────
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
WHATSAPP_BUSINESS_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER=
SOCIAL_PLATFORMS=telegram

# ── إعدادات التشغيل ───────────────────────────────────
COLLECTION_INTERVAL_MINUTES=15
MIN_IMPORTANCE_SCORE=55
MAX_NEWS_PER_BATCH=20

# ── RSS Feeds ─────────────────────────────────────────
RSS_FEEDS=https://www.mubasher.info/rss,https://www.argaam.com/ar/rss

# ── مصادر مصرية متخصصة (Scraping) ──────────────────────
# Enable with ENABLE_EGYPTIAN_SOURCES=1 for company-specific Egyptian news
ENABLE_EGYPTIAN_SOURCES=1
ALBORSAA_ENABLED=1
EGYPTIAN_DELAY_SECONDS=3

# فترة الاختبار للمصادر الجديدة (بالأيام)
NEW_SOURCE_GRACE_DAYS=7
NEW_SOURCE_MIN_IMPORTANCE=75

# ── فلتر المحتوى (EGX relevance) ───────────────────────
# The filter decides whether a news item is about the Egyptian stock market
# before it enters the DB. Three layers: keywords → ticker symbols → AI fallback.
KEYWORD_FILTER_USE_AI=1

# ── مجمّع توصيات الخبرين (Expert Recommendations Aggregator) ──
# Reads from news.db, aggregates similar recommendations from all sources per stock
# and sends results to /api/expert-recommendations/import on GLMinvestment.
EXPERT_AGGREGATOR_NAME=تحليل مجمّع (AI محلي)
EXPERT_AGGREGATOR_SOURCE=news_agent_aggregator
RECOMMENDATION_LOOKBACK_HOURS=48
RECOMMENDATION_MIN_SOURCES=1

# ── مسار GLMinvestment (للاستيراد المشترك) ────────────
# news_analyzer.py imports EGX_TICKER_NAMES from GLMinvestment/vps-service/analyzers/
# Default: <news_repo_parent>/GLMinvestment/vps-service
GLMINVESTMENT_PATH=
