# ── Telegram API ─────────────────────────────────────
# احصل عليهم من https://my.telegram.org/apps
TELEGRAM_API_ID=34557076
TELEGRAM_API_HASH=fe604a9844bf753210acb4e648af4155

# Telegram Bot Token (للنشر على القنوات)
TELEGRAM_BOT_TOKEN=8150921223:AAFteLXeaH_lutZC62auVorlaey9BfNJVP0
TELEGRAM_CHAT_ID=@Arabian_investment_guide

# قنوات التيليجرام للمراقبة (مفصولة بفاصلة)
TELEGRAM_CHANNELS=EGX_alerts,mubasher_egx,egyptstock,AlBorsaNews,EGXNews,egx_news_ar

# ── Ollama ────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=glm-fast:latest
OLLAMA_FALLBACK_MODEL=qwen2.5:1.5b
# نموذج الرؤية لفهم الصور (اختياري — اتركه فارغ لو مش محتاج)
OLLAMA_VISION_MODEL=

# ── الموقع المحلي (GLMinvestment) ────────────────────
LOCAL_SITE_URL=http://localhost:3000

# ──社交媒体 (غير مفعّل حالياً) ──────────────────
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
WHATSAPP_BUSINESS_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER=
SOCIAL_PLATFORMS=telegram

# ── إعدادات التشغيل ───────────────────────────────────
COLLECTION_INTERVAL_MINUTES=15
MIN_IMPORTANCE_SCORE=55
MAX_NEWS_PER_BATCH=20

# ── RSS Feeds ─────────────────────────────────────────
RSS_FEEDS=https://www.mubasher.info/rss,https://www.argaam.com/ar/rss

# ── مصادر مصرية متخصصة (Scraping) ──────────────────────
# متوقفة افتراضياً. فعّلها لتحصل على أخبار البورصة المصرية من مواقع محلية.
# المصادر الحالية: جريدة البورصة (alborsaanews.com)
# ملاحظة: تخضع لـ rate-limit و robots.txt وفترة اختبار (grace period).
ENABLE_EGYPTIAN_SOURCES=0
ALBORSAA_ENABLED=1
EGYPTIAN_DELAY_SECONDS=3

# فترة الاختبار للمصادر الجديدة (بالأيام) — خلالها يكون threshold أعلى
NEW_SOURCE_GRACE_DAYS=7
NEW_SOURCE_MIN_IMPORTANCE=75

# ── فلتر المحتوى (EGX relevance) ───────────────────────
# الفلتر يقرر هل الخبر متعلق بالبورصة المصرية قبل ما يدخل الـ DB.
# ثلاث طبقات: keywords سريعة → ticker symbols → AI fallback
KEYWORD_FILTER_USE_AI=1

# ── مجمّع توصيات الخبراء (Expert Recommendations Aggregator) ──
# يقرأ من news.db، يجمّع التوصيات المتشابهة من كل المصادر لكل سهم
# ويرسل النتيجة لـ /api/expert-recommendations/import على GLMinvestment.
EXPERT_AGGREGATOR_NAME=تحليل مجمّع (AI محلي)
EXPERT_AGGREGATOR_SOURCE=news_agent_aggregator
RECOMMENDATION_LOOKBACK_HOURS=48
RECOMMENDATION_MIN_SOURCES=1
