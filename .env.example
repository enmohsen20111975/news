# ====================================================
# 🔐 إعدادات مشروع محلل الأخبار الذكي
# ====================================================
# SECURITY NOTE (2026-09-02):
#   This file is a TEMPLATE. Never put real secrets here — they get pushed
#   to GitHub. Use placeholders only. Real values live in `.env` (gitignored).
#   If you previously saw real Telegram credentials here, they have been
#   REDACTED. The owner MUST revoke them at:
#     https://my.telegram.org/apps  (revoke API_HASH)
#     https://core.telegram.org/bots/father-robot  (revoke Bot Token)
#   Then run `git filter-branch` to scrub them from history.

# ── Telegram API ─────────────────────────────────────
# احصل عليهم من https://my.telegram.org/apps (ضع قيمك في .env فقط)
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID_HERE
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH_HERE

# Telegram Bot Token (للنشر على القنوات)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=@YOUR_CHANNEL_HERE

# قنوات التيليجرام للمراقبة (مفصولة بفاصلة)
TELEGRAM_CHANNELS=EGX_alerts,mubasher_egx,egyptstock,AlBorsaNews,EGXNews,egx_news_ar

# ── Ollama ────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=glm-fast:latest
OLLAMA_FALLBACK_MODEL=qwen2.5:1.5b
# نموذج الرؤية لفهم الصور (اختياري — اتركه فارغ لو مش محتاج)
OLLAMA_VISION_MODEL=

# ── الموقع المحلي (GLMinvestment) ────────────────────
LOCAL_SITE_URL=http://localhost:3000

# ── GLMinvestment API Key ─────────────────────────────
# نفس قيمة NEWS_AGENT_API_KEY في GLMinvestment/.env
# لازم تتطابق عشان الـ auth يشتغل على POST /api/news
PRODUCTION_API_KEY=YOUR_NEWS_AGENT_API_KEY_HERE

# ── السيرفر الإنتاجي (للاحتياط — بيبعت نسختين) ────────
PRODUCTION_SERVER_URL=https://invist.m2y.net

# ──社交媒体 (غير مفعّل حالياً) ──────────────────
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
WHATSAPP_BUSINESS_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER=
SOCIAL_PLATFORMS=telegram

# ── إعدادات التشغيل ───────────────────────────────────
COLLECTION_INTERVAL_MINUTES=15
MIN_IMPORTANCE_SCORE=55
MAX_NEWS_PER_BATCH=20

# ── RSS Feeds ─────────────────────────────────────────
RSS_FEEDS=https://www.mubasher.info/rss,https://www.argaam.com/ar/rss

# ── مصادر مصرية متخصصة (Scraping) ──────────────────────
# متوقفة افتراضياً. فعّلها لتحصل على أخبار البورصة المصرية من مواقع محلية.
# المصادر الحالية: جريدة البورصة (alborsaanews.com)
# ملاحظة: تخضع لـ rate-limit و robots.txt وفترة اختبار (grace period).
ENABLE_EGYPTIAN_SOURCES=0
ALBORSAA_ENABLED=1
EGYPTIAN_DELAY_SECONDS=3

# فترة الاختبار للمصادر الجديدة (بالأيام) — خلالها يكون threshold أعلى
NEW_SOURCE_GRACE_DAYS=7
NEW_SOURCE_MIN_IMPORTANCE=75

# ── مسار GLMinvestment (للاستيراد المشترك) ────────────
# news_analyzer.py بيستورد EGX_TICKER_NAMES من GLMinvestment/vps-service/analyzers/
# افتراضي: <news_repo_parent>/GLMinvestment/vps-service
# لو البنية مختلفة، اضبط هذا المتغير
GLMINVESTMENT_PATH=
